---
/**
 * Homepage — The main portfolio page.
 *
 * Sections: Split Layout -> Hero (Left) & Auto-Scrolling Featured Projects (Right)
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/portfolio/HeroSection.astro';
import ProjectsGrid from '../components/portfolio/ProjectsGrid.astro';
---

<BaseLayout>
  <div class="hero-split-wrapper">
    {/* ─── LEFT HALF: Reused Hero Component ─── */}
    <div class="hero-column">
      <HeroSection />
    </div>

    {/* ─── RIGHT HALF: Auto-Scrolling Projects ─── */}
    <div class="projects-column">
      <div class="projects-carousel" id="projects-carousel" style="scroll-behavior: auto;">
          <div class="scrolling-track" id="scrolling-track">
            <ProjectsGrid featured />
          </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .hero-split-wrapper {
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    overflow: hidden;
  }

  @media (min-width: 1024px) {
    .hero-split-wrapper {
      grid-template-columns: 1fr 1fr;
    }
  }

  .projects-column {
    width: 100%;
    min-width: 0;
    padding-block: var(--space-2xl);
  }

  /* Notice we removed the animation and added hidden overflow */
  .projects-carousel {
    width: 100%;
    overflow-x: hidden; /* Hides the scrollbar but allows JS to scroll it */
    mask-image: linear-gradient(to right, transparent, black 5%, black 95%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 5%, black 95%, transparent);
  }

  .scrolling-track {
    display: flex;
    width: max-content;
    /* We removed the CSS @keyframes animation here */
  }

  .scrolling-track > :global(*) {
    display: flex !important;
    flex-wrap: nowrap !important;
    gap: var(--space-md);
    padding-right: var(--space-md);
  }

  /* Optional: Add a subtle scale effect to the hovered card */
  .scrolling-track :global(a),
  .scrolling-track :global(article) {
    transition: transform 0.3s ease;
  }

  .scrolling-track :global(a:hover),
  .scrolling-track :global(article:hover) {
    transform: scale(1.02);
  }

  /* Update your existing global selector in index.astro to target the grid specifically */
  .scrolling-track :global(.projects-grid) {
    display: flex !important;
    flex-wrap: nowrap !important;
    gap: var(--space-md);
    padding-right: var(--space-md);
  }

  /* ─── ADD THIS: Constrain the project cards in the carousel ─── */
  .scrolling-track :global(.project-card) {
    width: 320px; /* Locks the card width. Adjust this number to your liking! */
    flex-shrink: 0; /* Prevents flexbox from squishing the cards together */
    white-space: normal; /* Ensures your description text still wraps properly */
  }

  /* Smooth transitions for all cards */
  #scrolling-track a {
    transition:
      opacity 0.3s ease,
      transform 0.3s ease,
      filter 0.3s ease;
    transform-origin: center center;
  }

  /* When the track is actively being hovered, dim ALL cards */
  #scrolling-track.is-hovered a {
    opacity: 0.4;
    filter: grayscale(80%);
    transform: scale(0.95); /* Slight shrink makes the zoomed card pop more */
  }

  /* The specific card being hovered stays fully visible and zooms in */
  #scrolling-track.is-hovered a.active-hover {
    opacity: 1;
    filter: grayscale(0%);
    transform: scale(1.1); /* Zoom in effect */
    z-index: 10;
    position: relative; /* Ensures it sits above the dimmed cards */
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const carousel = document.getElementById('projects-carousel') as HTMLElement | null;
    const track = document.getElementById('scrolling-track') as HTMLElement | null;

    // Grab the actual grid element rendered by Astro
    const originalGrid = track?.firstElementChild as HTMLElement | null;

    if (!carousel || !track || !originalGrid) return;

    // 1. DYNAMIC CLONING
    // Clone the grid twice so we always have enough runway to loop seamlessly
    const clone1 = originalGrid.cloneNode(true) as HTMLElement;
    const clone2 = originalGrid.cloneNode(true) as HTMLElement;
    track.appendChild(clone1);
    track.appendChild(clone2);

    // 2. PRECISE MEASUREMENT
    // Get the exact width of ONE grid block (including its internal gaps)
    let singleGridWidth = originalGrid.getBoundingClientRect().width;

    // Recalculate if the user resizes their browser window
    window.addEventListener('resize', () => {
      singleGridWidth = originalGrid.getBoundingClientRect().width;
    });

    let isPaused = false;
    let scrollSpeed = 1;
    let activeCard: HTMLAnchorElement | null = null;

    function autoScroll() {
      if (!isPaused) {
        carousel!.scrollLeft += scrollSpeed;

        // 3. THE PERFECT RESET
        // The moment we scroll exactly past the first grid block, we snap back.
        // Because clone1 looks identically positioned, the user's eye detects nothing.
        if (carousel!.scrollLeft >= singleGridWidth) {
          carousel!.scrollLeft -= singleGridWidth;
        }
      }
      requestAnimationFrame(autoScroll);
    }

    requestAnimationFrame(autoScroll);

    // --- HOVER LOGIC (Remains the same as before) ---
    track.addEventListener('mouseover', (e: MouseEvent) => {
      const target = e.target as Element;
      const card = target.closest('a');
      if (!card) return;

      if (activeCard === card) return;

      if (activeCard) {
        activeCard.classList.remove('active-hover');
      }

      activeCard = card;
      isPaused = true;

      track.classList.add('is-hovered');
      card.classList.add('active-hover');

      const carouselRect = carousel.getBoundingClientRect();
      const cardRect = card.getBoundingClientRect();

      const idealOffset =
        cardRect.left - carouselRect.left - carouselRect.width / 2 + cardRect.width / 2;

      const buffer = Math.min(20, cardRect.width / 4);
      const maxScroll = cardRect.right - e.clientX - buffer;
      const minScroll = cardRect.left - e.clientX + buffer;

      const safeOffset = Math.max(minScroll, Math.min(maxScroll, idealOffset));

      // This programmatic smooth scroll will still work perfectly even with the inline auto style
      carousel.scrollBy({ left: safeOffset, behavior: 'smooth' });
    });

    track.addEventListener('mouseout', (e: MouseEvent) => {
      const target = e.target as Element;
      const card = target.closest('a');
      if (!card) return;

      const related = e.relatedTarget as Element | null;

      if (related && card.contains(related)) {
        return;
      }

      card.classList.remove('active-hover');
      activeCard = null;

      const isMovingToAnotherCard = related instanceof Element ? related.closest('a') : null;

      if (!isMovingToAnotherCard) {
        track.classList.remove('is-hovered');
        isPaused = false;
      }
    });
  });
</script>