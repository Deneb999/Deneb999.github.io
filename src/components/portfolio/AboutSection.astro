---
/**
 * AboutSection — Bio paragraphs + skills grid.
 */
import Badge from '../ui/Badge.astro';
import SocialLinks from '../ui/SocialLinks.astro';
import { getCollection } from 'astro:content';

const profileEntries = await getCollection('profile');
const profile = profileEntries[0]?.data;
---

{
  profile && (
    <div class="about">
      <header class="about__header">
        <h1 class="about__name">{profile.name}</h1>
        <p class="about__role">{profile.role}</p>
        <SocialLinks github={profile.github} linkedin={profile.linkedin} email={profile.email} />
      </header>

      <div class="about__bio">
        {profile.bio.map((paragraph: string) => (
          <p>{paragraph}</p>
        ))}
      </div>

      <div class="about__skills">
        <h3 class="about__skills-title">Skills & Interests</h3>
        <div class="about__skills-list">
          {profile.skills.map((skill: string) => (
            <Badge>{skill}</Badge>
          ))}
        </div>
      </div>
    </div>
  )
}

<style>
  .about {
    display: grid;
    gap: var(--space-xl);
  }

  .about__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    margin-bottom: var(--space-lg);
  }

  .about__name {
    font-size: var(--font-size-3xl);
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.03em;
  }

  .about__role {
    font-size: var(--font-size-md);
    color: var(--color-text-muted);
  }

  @media (min-width: 768px) {
    .about {
      grid-template-columns: 2fr 1fr;
      gap: var(--space-2xl);
    }
  }

  .about__bio {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    font-size: var(--font-size-md);
    color: var(--color-text);
    line-height: var(--line-height-relaxed);
  }

  .about__skills-title {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-sm);
  }

  .about__skills-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }
</style>
